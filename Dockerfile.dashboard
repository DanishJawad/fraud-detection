# 3.11, not 3.10: see Dockerfile. Same lockfile, same constraint.
FROM python:3.11-slim

# Pinned to the uv version this repo was locked with (uv --version), so
# resolution behaves identically in and out of the container.
COPY --from=ghcr.io/astral-sh/uv:0.10.6 /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONPATH=/app

# --no-cache: see Dockerfile. Without it uv's download cache gets baked
# into the image alongside the installed venv.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-cache

COPY . /app

EXPOSE 8501
CMD ["uv", "run", "--no-sync", "streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
